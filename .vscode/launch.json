{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "FastAPI (reload)",
            "type": "python",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "src.api:app",
                "--reload",
                "--host", "0.0.0.0",
                "--port", "8000"
            ],
            "jinja": true,
            "envFile": "${workspaceFolder}/.env",
            "cwd": "${workspaceFolder}"
        }
    ]
}
